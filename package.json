{
  "name": "bambiui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/generate-source-catalog.mjs && node scripts/generate-registry.mjs && next dev",
    "build": "node scripts/generate-source-catalog.mjs && node scripts/generate-registry.mjs && next build",
    "source:catalog": "node scripts/generate-source-catalog.mjs",
    "registry:build": "node scripts/generate-registry.mjs",
    "registry:snapshot": "node scripts/snapshot-registry.mjs",
    "check:registry": "node scripts/build-cli.mjs && node scripts/check-registry-retention.mjs",
    "test:browser-process": "node --test scripts/disposable-browser-process.test.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "test:cli": "node scripts/generate-registry.mjs && node scripts/build-cli.mjs && node --test packages/cli/test/*.test.mjs",
    "check:cli": "node scripts/generate-registry.mjs && node scripts/build-cli.mjs && node scripts/check-cli-source.mjs --browser",
    "check:cli:clean": "node scripts/check-cli-source.mjs --published=0.2.1 --clean-install --browser",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sugar-high": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
